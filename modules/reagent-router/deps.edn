{:paths ["src"]

 :deps {reagent/reagent   {:mvn/version "1.2.0"}
        re-frame/re-frame {:mvn/version "1.4.3"}
        bidi/bidi         {:mvn/version "2.1.6"}
        kibu/pushy        {:mvn/version "0.3.8"}

        ;; `com.cemerick/url` -> `pathetic` -> `com.cemerick/clojurescript.test`, whose pom
        ;; drags in ClojureScript 0.0-1586 (from 2013). That is a test dependency that
        ;; leaked into a released pom; without this exclusion every consumer inherits an
        ;; ancient compiler in their dependency tree.
        com.cemerick/url  {:mvn/version "0.1.1"
                           :exclusions [com.cemerick/clojurescript.test]}}}
